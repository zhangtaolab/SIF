  "cards": [
    {
      "dot": "cyan",
      "title": "两个入口共用一条链路",
      "items": [
        "CLI 与 MCP 都构造 SearchPipeline，前缀 lex: / vec: / hyde: / expand: 决定走向",
        "MCP 每次调用新开 DatabaseConnection，在 asyncio 线程中执行",
        "lex: 查询不加载嵌入模型"
      ]
    },
    {
      "dot": "emerald",
      "title": "写入路径",
      "items": [
        "sif index update 与 sif watch 共用 IncrementalIndexer",
        "每个文件一个 BEGIN IMMEDIATE 提交，失败不丢已完成文件",
        "嵌入在事务外分批计算，再以单事务提交分块与向量"
      ]
    },
    {
      "dot": "amber",
      "title": "边界",
      "items": [
        "索引是单个 sif.db 文件；嵌入缓存另存 embeddings_cache.db",
        "跨进程写入由 {db_path}.lock 上的 flock 串行",
        "默认全部本地；只有选 OpenAI / ModelScope 后端时文本才离开本机"
      ]
    },
    {
      "dot": "violet",
      "title": "降级与开关",
      "items": [
        "无 sqlite-vec 时向量检索直接报错，BM25 仍可用",
        "重排默认关闭，--rerank 或 SIF_RERANK_ENABLED=1 才启用",
        "嵌入身份或维度不匹配：混合检索退回 BM25 并标记向量过期"
      ]
    }
  ]
